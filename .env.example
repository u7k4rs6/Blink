# Solari API key. One key covers sandboxes and browsers against one balance.
# Get one at https://console.getsolari.com
# The gates read this ONCE at the process edge and thread it down as an
# argument. Nothing under src/solari/ reads it from the environment.
SOLARI_API_KEY=slr_live_replace_me

# Plan the ceilings and rates are computed against. starter | free
BLINK_PLAN=starter
