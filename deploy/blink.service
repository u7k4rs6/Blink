# systemd unit for the Blink web server.
#
# Three things here are load bearing rather than boilerplate, and each one exists
# because the alternative was measured or hit.

[Unit]
Description=Blink
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blink
Group=blink
WorkingDirectory=/opt/blink

# TZ=UTC is REQUIRED, not a preference. src/day.ts asserts it at boot and the
# server refuses launches without it, because node-pg parses a `date` column at
# LOCAL midnight: a non-UTC process files every ledger row under the wrong day
# and the daily ceiling silently resets early. That bug happened once already
# and was invisible in every environment except the real one.
Environment=TZ=UTC
Environment=NODE_ENV=production
Environment=PORT=8787

# Where this runs, declared rather than detected, because the health wall's job
# is not guessing. Set here rather than by hand on the host: provision.sh copies
# this file over /etc/systemd/system/blink.service on every deploy, so a value
# edited on the box survives exactly until the next one. That is how the health
# wall went back to claiming a laptop twenty minutes after it stopped being on
# one.
Environment=BLINK_ON_LAPTOP=0

# Secrets come from a file mode 600 owned by blink, never from this unit, which
# is world readable via systemctl cat.
EnvironmentFile=/etc/blink/blink.env

ExecStart=/usr/bin/node /opt/blink/src/web/server.ts

# SIGTERM, then time to settle. The server kills every live instance and writes
# their receipts on shutdown; killing it faster than that leaks sandboxes that
# bill until the platform timeout catches them.
KillSignal=SIGTERM
TimeoutStopSec=45

Restart=always
RestartSec=3

# The boot path adopts orphaned instances from the previous process, so a restart
# settles what it left behind rather than abandoning it.

# Hardening. The process needs to write its instance log and read its config,
# and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blink
StateDirectory=blink
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native

# MemoryDenyWriteExecute is NOT set, and that is deliberate.
#
# It was set here, and it makes this unit unstartable. V8 is a JIT: it maps a
# region, writes machine code into it, then marks it executable, which is
# exactly the transition the directive forbids. Node dies inside
# Isolate::Initialize before any of this repository's code runs, with
#
#   # Fatal error in , line 0
#   # Check failed: 12 == (*__errno_location ()).
#   ... v8::base::OS::SetPermissions ...
#
# and systemd reports it as a core dump, which reads like a crash in the
# application rather than a policy refusal in the sandbox. Nothing else in this
# unit is relaxed to accommodate it: the process still has no new privileges, a
# private tmp, a read-only system with one writable state directory, no home, no
# kernel tunables, three address families and a locked personality.

[Install]
WantedBy=multi-user.target
