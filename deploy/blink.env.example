# Copy to /etc/blink/blink.env, chmod 600, chown blink:blink.
# Never commit the real file. Never echo it. It does not expire.

# Required. Without it the catalog and health wall still serve, and launching is
# refused with a message saying why.
SOLARI_API_KEY=slr_live_...

# Required in production. Without it the ledger runs in memory, the daily
# ceiling resets on every restart, and the health wall says so publicly.
DATABASE_URL=postgresql://...

# Required unless deliberately disabled. Turnstile is the only thing between an
# anonymous visitor and a machine with unrestricted egress (Q5, V57).
TURNSTILE_SECRET=

# Set to 1 ONLY for local development. In production this is how the site gets
# abused, so it is spelled out rather than defaulted.
# BLINK_TURNSTILE_DISABLED=1

# Optional overrides. Defaults are in the source and are the measured ones.
# BLINK_LIFETIME_MS=600000
# BLINK_PLATFORM_TIMEOUT_MS=180000
# BLINK_HEARTBEAT_MS=45000
# BLINK_CANARY_INTERVAL_MS=900000
# BLINK_WEB_CEILING_USD=0.5
